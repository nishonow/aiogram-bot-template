# Copy this file to `.env` and fill in the values.

# Token from @BotFather
BOT_TOKEN=123456:your-telegram-bot-token

# Comma-separated list of Telegram user IDs with permanent admin access.
# These admins cannot be removed at runtime; any admin added via /admin
# is stored in the database separately.
ADMINS=123456789,987654321

# Optional: path to the SQLite database file. Defaults to `bot.db`
# in the working directory. Use an absolute path in production.
# DB_PATH=/var/lib/mybot/bot.db

# Optional: logging level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# LOG_LEVEL=INFO
